<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900">My Pitch Rooms</h1>
      <%= link_to "New Room", new_room_path, class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition" %>
    </div>

    <% if @rooms.any? %>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <% @rooms.each do |room| %>
          <div class="bg-white rounded-lg shadow-sm hover:shadow-md transition p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-2"><%= room.title %></h2>
            <p class="text-sm text-gray-500 mb-4"><%= pluralize(room.items.count, 'item') %></p>
            
            <div class="flex gap-2 mb-4">
              <%= link_to "Manage", room_path(room), class: "text-indigo-600 hover:text-indigo-800" %>
              <span class="text-gray-300">|</span>
              <%= link_to "Edit", edit_room_path(room), class: "text-gray-600 hover:text-gray-800" %>
            </div>

            <div class="border-t pt-4">
              <label class="block text-xs text-gray-500 mb-1">Share Link:</label>
              <div class="flex gap-2">
                <input 
                  type="text" 
                  value="<%= public_room_url(room.token) %>" 
                  readonly 
                  class="flex-1 px-3 py-1 text-sm bg-gray-50 border border-gray-300 rounded"
                  onclick="this.select()"
                >
                <button 
                  onclick="navigator.clipboard.writeText('<%= public_room_url(room.token) %>'); this.textContent = 'Copied!'; setTimeout(() => this.textContent = 'Copy', 2000)"
                  class="px-3 py-1 text-sm bg-gray-200 hover:bg-gray-300 rounded"
                >
                  Copy
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <p class="text-gray-500 mb-4">You haven't created any pitch rooms yet.</p>
        <%= link_to "Create your first room", new_room_path, class: "px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition inline-block" %>
      </div>
    <% end %>
  </div>
</div>
