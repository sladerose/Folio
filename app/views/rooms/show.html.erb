<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <div class="flex justify-between items-start mb-4">
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= @room.title %></h1>
          <p class="text-sm text-gray-500 mt-1"><%= pluralize(@room.viewers.count, 'view') %></p>
        </div>
        <%= link_to "← Back to Rooms", rooms_path, class: "text-indigo-600 hover:text-indigo-800" %>
      </div>

      <div class="bg-white rounded-lg shadow-sm p-4 mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">Public Share Link:</label>
        <div class="flex gap-2">
          <input 
            type="text" 
            value="<%= public_room_url(@room.token) %>" 
            readonly 
            class="flex-1 px-4 py-2 bg-gray-50 border border-gray-300 rounded-lg"
            onclick="this.select()"
          >
          <button 
            onclick="navigator.clipboard.writeText('<%= public_room_url(@room.token) %>'); this.textContent = 'Copied!'; setTimeout(() => this.textContent = 'Copy Link', 2000)"
            class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition"
          >
            Copy Link
          </button>
        </div>
      </div>
    </div>

    <!-- Content Items -->
    <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Content</h2>
      
      <% if @items.any? %>
        <div class="space-y-4">
          <% @items.each do |item| %>
            <div class="border border-gray-200 rounded-lg p-4 hover:border-gray-300 transition">
              <div class="flex justify-between items-start">
                <div class="flex-1">
                  <% if item.itemable_type == 'Link' %>
                    <div class="flex items-center gap-2 mb-1">
                      <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                      </svg>
                      <h3 class="font-semibold text-gray-900"><%= item.itemable.title %></h3>
                    </div>
                    <p class="text-sm text-gray-600 mb-2"><%= item.itemable.description %></p>
                    <a href="<%= item.itemable.url %>" target="_blank" class="text-sm text-indigo-600 hover:text-indigo-800"><%= item.itemable.url %></a>
                  <% elsif item.itemable_type == 'Document' %>
                    <div class="flex items-center gap-2 mb-1">
                      <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                      </svg>
                      <h3 class="font-semibold text-gray-900"><%= item.itemable.title %></h3>
                    </div>
                    <p class="text-sm text-gray-600"><%= item.itemable.description %></p>
                  <% end %>
                </div>
                <%= button_to "Delete", room_item_path(@room, item), method: :delete, class: "text-red-600 hover:text-red-800 text-sm", data: { turbo_confirm: "Are you sure?" } %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">No content yet. Add your first link or document below.</p>
      <% end %>
    </div>

    <!-- Add Link Form -->
    <div class="bg-white rounded-lg shadow-sm p-6 mb-4">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Add Link</h3>
      <%= form_with(url: room_items_path(@room), method: :post, local: true) do |form| %>
        <%= hidden_field_tag :type, 'link' %>
        <div class="space-y-4">
          <div>
            <%= label_tag 'link[title]', 'Title', class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= text_field_tag 'link[title]', nil, class: "w-full px-4 py-2 border border-gray-300 rounded-lg", placeholder: "My Portfolio Website" %>
          </div>
          <div>
            <%= label_tag 'link[url]', 'URL', class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= url_field_tag 'link[url]', nil, class: "w-full px-4 py-2 border border-gray-300 rounded-lg", placeholder: "https://example.com" %>
          </div>
          <div>
            <%= label_tag 'link[description]', 'Description (optional)', class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= text_area_tag 'link[description]', nil, class: "w-full px-4 py-2 border border-gray-300 rounded-lg", rows: 2 %>
          </div>
          <%= submit_tag "Add Link", class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <!-- Add Document Form -->
    <div class="bg-white rounded-lg shadow-sm p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Add Document</h3>
      <%= form_with(url: room_items_path(@room), method: :post, local: true, multipart: true) do |form| %>
        <%= hidden_field_tag :type, 'document' %>
        <div class="space-y-4">
          <div>
            <%= label_tag 'document[title]', 'Title', class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= text_field_tag 'document[title]', nil, class: "w-full px-4 py-2 border border-gray-300 rounded-lg", placeholder: "My Resume" %>
          </div>
          <div>
            <%= label_tag 'document[description]', 'Description (optional)', class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= text_area_tag 'document[description]', nil, class: "w-full px-4 py-2 border border-gray-300 rounded-lg", rows: 2 %>
          </div>
          <div>
            <%= label_tag 'document[file]', 'File', class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= file_field_tag 'document[file]', class: "w-full px-4 py-2 border border-gray-300 rounded-lg" %>
          </div>
          <%= submit_tag "Add Document", class: "px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
