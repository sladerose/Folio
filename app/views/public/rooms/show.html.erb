<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-purple-50 py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Room Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4"><%= @room.title %></h1>
      <div class="inline-block px-4 py-1 bg-indigo-100 text-indigo-700 rounded-full text-sm">
        <%= pluralize(@items.count, 'item') %>
      </div>
    </div>

    <!-- Content Grid -->
    <% if @items.any? %>
      <div class="space-y-6">
        <% @items.each do |item| %>
          <% if item.itemable_type == 'Link' %>
            <a href="<%= item.itemable.url %>" target="_blank" class="block bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all p-6 border border-gray-100 hover:border-indigo-200 group">
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-12 h-12 bg-indigo-100 rounded-xl flex items-center justify-center group-hover:bg-indigo-200 transition">
                  <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-indigo-600 transition"><%= item.itemable.title %></h3>
                  <% if item.itemable.description.present? %>
                    <p class="text-gray-600 mb-3"><%= item.itemable.description %></p>
                  <% end %>
                  <p class="text-sm text-indigo-600 font-medium"><%= item.itemable.url %> →</p>
                </div>
              </div>
            </a>
          <% elsif item.itemable_type == 'Document' %>
            <div class="bg-white rounded-2xl shadow-sm p-6 border border-gray-100">
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                  <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <h3 class="text-xl font-semibold text-gray-900 mb-2"><%= item.itemable.title %></h3>
                  <% if item.itemable.description.present? %>
                    <p class="text-gray-600 mb-3"><%= item.itemable.description %></p>
                  <% end %>
                  <% if item.itemable.file.attached? %>
                    <%= link_to "Download", rails_blob_path(item.itemable.file, disposition: "attachment"), class: "inline-flex items-center gap-2 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition text-sm font-medium" %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16">
        <p class="text-gray-500 text-lg">No content available yet.</p>
      </div>
    <% end %>

    <!-- Powered by Folio -->
    <div class="text-center mt-16">
      <p class="text-sm text-gray-400">Powered by <span class="font-semibold">Folio</span></p>
    </div>
  </div>
</div>
